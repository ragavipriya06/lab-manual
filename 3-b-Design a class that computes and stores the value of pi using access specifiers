public class PiValue {

    public double publicPi = 3.14159;
    private double privatePi = 3.14159;
    protected double protectedPi = 3.14159;

    public void display() {
        System.out.println("Public Pi = " + publicPi);
        System.out.println("Private Pi = " + privatePi);
        System.out.println("Protected Pi = " + protectedPi);
    }

    public static void main(String[] args) {
        PiValue obj = new PiValue();
        obj.display();
    }
}